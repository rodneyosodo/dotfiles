// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "inlay_hints": {
    "enabled": true,
  },
  "buffer_font_features": {
    "calt": 0,
  },
  "minimap": {
    "show": "auto",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": [],
      },
    },
  },
  "context_servers": {
    "libsql-context-server": {
      "enabled": true,
      "settings": {},
    },
  },
  "agent_servers": {
    "opencode": {
      "type": "registry",
    },
  },
  "git_panel": {
    "sort_by_path": true,
    "tree_view": false,
  },
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
    "enabled_in_text_threads": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Great Icons Theme",
    "dark": "VSCode Great Icons Theme",
  },
  "ssh_connections": [
    {
      "host": "bohr",
      "username": "rodneyosodo",
      "projects": [
        {
          "paths": ["~/homelab"],
        },
      ],
    },
  ],
  "vim_mode": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
    },
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "file_icons": true,
    "button": true,
  },
  "languages": {
    "YAML": {
      "indent_guides": {
        "background_coloring": "disabled",
      },
      "tab_size": 2,
    },
    "Markdown": {
      "soft_wrap": "editor_width",
    },
  },
  "terminal": {
    "font_size": 13,
    "copy_on_select": true,
  },
  "scroll_beyond_last_line": "one_page",
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4",
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Dark",
    "dark": "Gruvbox Dark Hard",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "enable_language_server": true,
  "format_on_save": "on",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "load_direnv": "direct",
  "auto_install_extensions": {
    "basher": true,
    "biome": true,
    "charmed-icons": true,
    "colored-zed-icons-theme": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "erlang": true,
    "git-firefly": true,
    "golangci-lint": true,
    "graphql": true,
    "html": true,
    "libsql-context-server": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "mcp-server-github": true,
    "ruff": true,
    "sql": true,
    "tailwind-theme": true,
    "terraform": true,
    "toml": true,
    "vscode-great-icons": true,
    "wakatime": true,
    "zig": true,
  },
}
