// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "proxy": "",
  "base_keymap": "Cursor",
  "diff_view_style": "split",
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "colorize_brackets": false,
  "tasks": {
    "enabled": true,
  },
  "lsp_document_colors": "inlay",
  "cursor_blink": true,
  "text_rendering_mode": "platform_default",
  "ui_font_family": ".ZedSans",
  "buffer_font_family": ".ZedMono",
  "inlay_hints": {
    "show_background": false,
    "show_other_hints": true,
    "show_parameter_hints": true,
    "show_type_hints": false,
    "show_value_hints": true,
    "enabled": true,
  },
  "buffer_font_features": {
    "calt": 0,
  },
  "minimap": {
    "show": "never",
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
    "clangd": {
      "binary": {
        "path": "/usr/bin/clangd",
        "arguments": [],
      },
    },
  },
  "context_servers": {
    "libsql-context-server": {
      "enabled": true,
      "settings": {},
    },
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "model": "claude-opus-5"
      },
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "model": "opencode-go/deepseek-v4-pro",
      },
      "type": "registry",
    },
  },
  "git_panel": {
    "sort_by": "path",
    "group_by": "status",
    "dock": "left",
    "sort_by_path": false,
    "tree_view": false,
  },
  "edit_predictions": {
    "disabled_globs": [],
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null,
      "enterprise_uri": null,
    },
    "enabled_in_text_threads": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "VSCode Great Icons Theme",
    "dark": "VSCode Great Icons Theme",
  },
  "ssh_connections": [
    {
      "host": "bohr",
      "username": "rodneyosodo",
      "projects": [
        {
          "paths": ["~/homelab"],
        },
      ],
    },
  ],
  "vim_mode": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": true,
    },
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "file_icons": true,
    "button": true,
  },
  "languages": {
    "YAML": {
      "indent_guides": {
        "background_coloring": "disabled",
      },
      "tab_size": 2,
    },
    "Markdown": {
      "soft_wrap": "editor_width",
    },
  },
  "terminal": {
    "font_size": 13,
    "copy_on_select": true,
  },
  "scroll_beyond_last_line": "one_page",
  "agent": {
    "dock": "right",
    "default_model": {
      "effort": "max",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "go/deepseek-v4-flash",
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Hard",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "enable_language_server": true,
  "format_on_save": "on",
  "ui_font_size": 14,
  "buffer_font_size": 14,
  "load_direnv": "direct",
  "auto_install_extensions": {
    "basher": true,
    "biome": true,
    "charmed-icons": true,
    "colored-zed-icons-theme": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "erlang": true,
    "git-firefly": true,
    "golangci-lint": true,
    "graphql": true,
    "html": true,
    "libsql-context-server": true,
    "lua": true,
    "make": true,
    "markdown-oxide": true,
    "mcp-server-github": true,
    "ruff": true,
    "sql": true,
    "tailwind-theme": true,
    "terraform": true,
    "toml": true,
    "vscode-great-icons": true,
    "wakatime": true,
    "zig": true,
  },
  "code_actions_on_format": {
    "source.organizeImports.biome": true,
    "source.fixAll.biome": true,
  },
}
